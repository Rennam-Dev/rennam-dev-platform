FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app app

COPY requirements.txt requirements-dev.txt requirements-test.lock ./
RUN python -m pip install -c requirements-test.lock -r requirements-dev.txt

COPY --chown=app:app . .
USER app

CMD ["sh", "scripts/verify.sh"]
