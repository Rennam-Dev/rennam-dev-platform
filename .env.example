# Perfil de exemplo SOMENTE para development. Não reutilize estes placeholders
# em staging/production; esses ambientes falham no startup sem valores próprios.
# APP_ENV aceita somente: development, test, staging ou production.
APP_ENV=development
# URL e senha abaixo são locais e públicas; substitua ambas em qualquer deploy.
DATABASE_URL=postgresql+psycopg://rennam:troque-esta-senha@localhost:5432/rennam_dev
POSTGRES_PASSWORD=troque-esta-senha
# Em staging/production, substitua por valor não default com ao menos 32
# caracteres. `openssl rand -hex 32` gera 64.
SESSION_SECRET=gere-com-openssl-rand-hex-32
ADMIN_USERNAME=rennam
# Em staging/production, este valor é obrigatório e deve ser um hash Argon2.
ADMIN_PASSWORD_HASH='cole-aqui-o-hash-argon2'
# A 5ª falha em 10 minutos bloqueia novas tentativas desse IP durante a janela.
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_SECONDS=600
# Limite de IPs mantidos pelo processo para impedir crescimento ilimitado.
ADMIN_LOGIN_MAX_CLIENTS=10000
# Em staging/production, inclua o hostname exato de SITE_URL; sem wildcard.
ALLOWED_HOSTS=127.0.0.1,localhost
# Somente IPs/redes do proxy controlado; `*` e redes `/0` são rejeitados.
FORWARDED_ALLOW_IPS=127.0.0.1
# Em staging/production, deve ser HTTPS, absoluta e sem credenciais/query/fragment.
SITE_URL=http://127.0.0.1:8000
GITHUB_URL=https://github.com/seu-usuario
LINKEDIN_URL=https://www.linkedin.com/in/seu-usuario
CONTACT_EMAIL=eu@rennam.dev
