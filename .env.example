# APP_ENV aceita somente: development, test, staging ou production.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://rennam:troque-esta-senha@localhost:5432/rennam_dev
POSTGRES_PASSWORD=troque-esta-senha
# Em production, use ao menos 32 caracteres. `openssl rand -hex 32` gera 64.
SESSION_SECRET=gere-com-openssl-rand-hex-32
ADMIN_USERNAME=rennam
# Em production, este valor é obrigatório e deve ser um hash Argon2 completo.
ADMIN_PASSWORD_HASH='cole-aqui-o-hash-argon2'
# A 5ª falha em 10 minutos bloqueia novas tentativas desse IP durante a janela.
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_SECONDS=600
# Limite de IPs mantidos pelo processo para impedir crescimento ilimitado.
ADMIN_LOGIN_MAX_CLIENTS=10000
# Em production, deve ser HTTPS, absoluta e sem query string ou fragment.
SITE_URL=http://127.0.0.1:8000
GITHUB_URL=https://github.com/seu-usuario
LINKEDIN_URL=https://www.linkedin.com/in/seu-usuario
CONTACT_EMAIL=eu@rennam.dev
